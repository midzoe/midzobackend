# Database Configuration
# Local development with MySQL

# Prisma Database URL - MySQL (local development)
# DATABASE_URL="mysql://root:@localhost:3306/midzo"
DATABASE_URL="postgres://1dc6886f99430b5e35ab430d845657d7a72780cd5a627ffc430225e1ef39f63a:sk_MtWEz4Jj_FSedcGjNArq-@db.prisma.io:5432/postgres?sslmode=require"


# Server Configuration
PORT=3001
NODE_ENV=development

# Authentication
JWT_SECRET=your_jwt_secret_key_here
JWT_EXPIRES_IN=24h

# CORS
FRONTEND_URL=http://localhost:5173

# Email (SMTP) — required for verification emails
# For Gmail: enable "App Passwords" and use it as EMAIL_PASS
EMAIL_HOST=smtp.gmail.com
EMAIL_PORT=587
EMAIL_SECURE=false
EMAIL_USER=your_email@gmail.com
EMAIL_PASS=your_app_password
EMAIL_FROM=noreply@midzoe.com

# Stripe — paiement des packages premium (story 3.4)
# Clés de test sur https://dashboard.stripe.com/test/apikeys
# STRIPE_WEBHOOK_SECRET : donné par `stripe listen --forward-to localhost:3001/api/webhooks/stripe`
# Sans ces clés : /api/premium/checkout et /api/webhooks/stripe répondent 503 (pas de mode dégradé).
STRIPE_SECRET_KEY=sk_test_your_stripe_secret_key
STRIPE_WEBHOOK_SECRET=whsec_your_webhook_signing_secret
STRIPE_SUCCESS_URL=http://localhost:5173/premium/success?session_id={CHECKOUT_SESSION_ID}
STRIPE_CANCEL_URL=http://localhost:5173/premium/cancel
