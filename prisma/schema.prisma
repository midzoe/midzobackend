// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                     Int       @id @default(autoincrement())
  username               String    @unique
  email                  String    @unique
  passwordHash           String    @map("password_hash")
  firstName              String?   @map("first_name")
  lastName               String?   @map("last_name")
  phone                  String?
  role                   String    @default("user") // "user" | "admin" | "superadmin"
  nationality            String?
  countryOfResidence     String?   @map("country_of_residence")
  isPremium              Boolean   @default(false) @map("is_premium")
  premiumSince           DateTime? @map("premium_since")
  newsletterStudy        Boolean   @default(false) @map("newsletter_study")
  newsletterTourism      Boolean   @default(false) @map("newsletter_tourism")
  emailVerified          Boolean   @default(false) @map("email_verified")
  verificationCode       String?   @map("verification_code")
  verificationCodeExpiry DateTime? @map("verification_code_expiry")
  verificationCodeSentAt DateTime? @map("verification_code_sent_at")
  createdAt              DateTime  @default(now()) @map("created_at")
  updatedAt              DateTime  @updatedAt @map("updated_at")

  // Relations
  bookings      UserBooking[]
  languages     UserLanguage[]
  notifications Notification[]
  trips         Trip[]
  purchases     Purchase[]
  premiumCase   PremiumCase?

  @@map("users")
}

// Story 9.3 (FR38) : suivi de dossier séparé pour les clients premium (accompagnement humain).
model PremiumCase {
  id         Int      @id @default(autoincrement())
  userId     Int      @unique @map("user_id")
  status     String   @default("open") // « open » | « in_progress » | « closed »
  notes      String?
  assignedTo String?  @map("assigned_to")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("premium_cases")
}

model UserLanguage {
  id       Int    @id @default(autoincrement())
  userId   Int    @map("user_id")
  language String
  level    String // "A1"|"A2"|"B1"|"B2"|"C1"|"C2"

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, language])
  @@map("user_languages")
}

model Category {
  id          String   @id
  name        String
  description String?
  icon        String?
  isPublic    Boolean  @default(true) @map("is_public")
  order       Int      @default(0)
  createdAt   DateTime @default(now()) @map("created_at")

  // Relations
  services      Service[]
  subcategories Subcategory[]
  packages      PackageCategory[]

  @@map("categories")
}

/// Config tarifaire globale (singleton, id = 1). Montants en CENTIMES entiers :
/// les flottants fausseraient les remises dégressives, et Stripe travaille en centimes.
/// Valeurs initiales à 0 — les tarifs sont saisis par l'admin (aucun montant inventé).
model PricingConfig {
  id                             Int      @id @default(1)
  pricePerSubcategoryCents       Int      @default(0) @map("price_per_subcategory_cents")
  discountTwoCategoriesPct       Int      @default(0) @map("discount_two_categories_pct")
  discountThreePlusCategoriesPct Int      @default(0) @map("discount_three_plus_categories_pct")
  currency                       String   @default("EUR")
  updatedAt                      DateTime @updatedAt @map("updated_at")

  @@map("pricing_config")
}

model Package {
  id                       Int      @id @default(autoincrement())
  name                     String   @unique
  description              String?
  basePriceCents           Int      @default(0) @map("base_price_cents")
  /// null => repli sur PricingConfig.pricePerSubcategoryCents
  pricePerSubcategoryCents Int?     @map("price_per_subcategory_cents")
  isFullPackage            Boolean  @default(false) @map("is_full_package")
  isCustom                 Boolean  @default(false) @map("is_custom")
  isActive                 Boolean  @default(true) @map("is_active")
  order                    Int      @default(0)

  // --- Grille commerciale (vitrine publique) -------------------------------
  // Deux natures de package cohabitent volontairement dans cette table :
  //  - `family = null`  => package du MOTEUR DE DEVIS (stories 3.2/3.3) : il porte des
  //    catégories et sert au calcul du prix à la carte. Jamais affiché dans la vitrine.
  //  - `family != null` => PALIER de la grille commerciale (Starter, Escape, Mix XXL…) :
  //    prix d'appel figé et liste d'avantages, jamais mêlé au calcul du devis.
  /// "study" | "tourism" | "mix" | "consultation" — null = package du moteur de devis.
  family         String?
  /// Identifiant lisible de l'URL / du lien CTA (ex. "study-starter").
  slug           String?  @unique
  /// Accroche courte du palier ("2 services au choix").
  tagline        String?
  /// Nombre de services annoncé sur la carte ("1 SERVICE", "3-4 SERVICES", "PREMIUM+").
  serviceLabel   String?  @map("service_label")
  /// Prix d'appel affiché « à partir de », en CENTIMES (cohérent avec basePriceCents).
  priceFromCents Int      @default(0) @map("price_from_cents")
  /// "once" = paiement unique | "month" = par mois (packages Mix du flyer).
  billingPeriod  String   @default("once") @map("billing_period")
  currency       String   @default("EUR")
  /// Avantages listés sur la carte, dans l'ordre d'affichage.
  features       String[]
  /// Pastille éditoriale ("Le plus choisi") — vide = pas de pastille.
  badge          String?
  isHighlighted  Boolean  @default(false) @map("is_highlighted")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relations
  categories PackageCategory[]
  purchases  Purchase[]

  @@index([family, order])
  @@map("packages")
}

/// Achat ponctuel d'un package (story 3.4). Montants en CENTIMES entiers.
/// Pas d'abonnement récurrent en v1 : le premium est permanent une fois acquis.
model Purchase {
  id                    Int       @id @default(autoincrement())
  userId                Int       @map("user_id")
  /// null => package personnalisé (aucun package prédéfini ne correspondait)
  packageId             Int?      @map("package_id")
  isCustom              Boolean   @default(false) @map("is_custom")
  amountCents           Int       @map("amount_cents")
  currency              String    @default("EUR")
  /// Snapshot du devis AU MOMENT DE L'ACHAT (contrat story 3.2). Les tarifs évoluent,
  /// la facture non : le détail doit rester lisible des mois plus tard.
  quote                 Json
  status                String    @default("pending") // "pending" | "paid"
  /// Référence de paiement — UNIQUE : garde-fou en base contre le double
  /// enregistrement d'un même paiement (FR8, idempotence).
  stripeSessionId       String?   @unique @map("stripe_session_id")
  stripePaymentIntentId String?   @map("stripe_payment_intent_id")
  createdAt             DateTime  @default(now()) @map("created_at")
  paidAt                DateTime? @map("paid_at")

  // Relations
  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  package Package? @relation(fields: [packageId], references: [id], onDelete: SetNull)

  @@map("purchases")
}

model PackageCategory {
  id         Int    @id @default(autoincrement())
  packageId  Int    @map("package_id")
  categoryId String @map("category_id")

  // Relations
  package  Package  @relation(fields: [packageId], references: [id], onDelete: Cascade)
  category Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@unique([packageId, categoryId], map: "uq_package_category")
  @@map("package_categories")
}

model Subcategory {
  id         Int      @id @default(autoincrement())
  categoryId String   @map("category_id")
  name       String
  order      Int      @default(0)
  isOther    Boolean  @default(false) @map("is_other")
  createdAt  DateTime @default(now()) @map("created_at")

  // Relations
  category Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@unique([categoryId, name], map: "uq_subcategory_categoryId_name")
  @@map("subcategories")
}

model Service {
  id             Int      @id @default(autoincrement())
  name           String // clé de catalogue, alignée sur Subcategory.name et les clés front
  displayName    String?  @map("display_name") // libellé affiché quand il diffère de la clé
  description    String?
  image          String?
  learnMoreLink  String?  @map("learn_more_link")
  translationKey String?  @map("translation_key")
  isExternal     Boolean  @default(false) @map("is_external") // redirige vers une plateforme partenaire
  deliveryMode   String   @default("online") @map("delivery_mode") // "online"|"physical"|"hybrid"
  order          Int      @default(0)
  categoryId     String   @map("category_id")
  createdAt      DateTime @default(now()) @map("created_at")

  // Relations
  category Category      @relation(fields: [categoryId], references: [id])
  bookings UserBooking[]

  @@unique([categoryId, name], map: "uq_service_categoryId_name")
  @@map("services")
}

model Country {
  id                Int      @id @default(autoincrement())
  name              String   @unique
  code              String?  @unique
  region            String?
  heroImage         String?  @map("hero_image")
  motto             String?
  history           String?
  culturalImage     String?  @map("cultural_image")
  modernLife        String?  @map("modern_life")
  modernImage       String?  @map("modern_image")
  studyAvailable    Boolean  @default(false) @map("study_available")
  tourismAvailable  Boolean  @default(false) @map("tourism_available")
  visaInfoAvailable Boolean  @default(false) @map("visa_info_available")
  isValidated       Boolean  @default(false) @map("is_validated")
  // Ordre d'affichage curaté (position dans la liste des pays d'études du Hero) ; 0 = non curaté.
  order             Int      @default(0)
  // Traductions fr/de des champs textuels du pays : { fr: { motto, history, modernLife }, de: {...} }
  translations      Json?
  createdAt         DateTime @default(now()) @map("created_at")

  // Relations
  quickFacts CountryQuickFact[]
  traditions CountryTradition[]
  cuisine    CountryCuisine[]
  places     CountryPlace[]
  trends     CountryTrend[]

  @@map("countries")
}

model CountryQuickFact {
  id           Int    @id @default(autoincrement())
  countryId    Int    @map("country_id")
  title        String
  value        String
  order        Int    @default(0)
  // { fr: { title, value }, de: { title, value } }
  translations Json?

  // Relations
  country Country @relation(fields: [countryId], references: [id], onDelete: Cascade)

  @@unique([countryId, title], map: "uq_country_quickfact_countryId_title")
  @@map("country_quick_facts")
}

model CountryTradition {
  id           Int     @id @default(autoincrement())
  countryId    Int     @map("country_id")
  name         String
  description  String?
  image        String?
  order        Int     @default(0)
  // { fr: { name, description }, de: { name, description } }
  translations Json?

  // Relations
  country Country @relation(fields: [countryId], references: [id], onDelete: Cascade)

  @@unique([countryId, name], map: "uq_country_tradition_countryId_name")
  @@map("country_traditions")
}

model CountryCuisine {
  id           Int     @id @default(autoincrement())
  countryId    Int     @map("country_id")
  name         String
  description  String?
  image        String?
  order        Int     @default(0)
  // { fr: { name, description }, de: { name, description } }
  translations Json?

  // Relations
  country Country @relation(fields: [countryId], references: [id], onDelete: Cascade)

  @@unique([countryId, name], map: "uq_country_cuisine_countryId_name")
  @@map("country_cuisine")
}

model CountryPlace {
  id           Int     @id @default(autoincrement())
  countryId    Int     @map("country_id")
  name         String
  description  String?
  image        String?
  order        Int     @default(0)
  // { fr: { name, description }, de: { name, description } }
  translations Json?

  // Relations
  country Country @relation(fields: [countryId], references: [id], onDelete: Cascade)

  @@unique([countryId, name], map: "uq_country_place_countryId_name")
  @@map("country_places")
}

model CountryTrend {
  id           Int    @id @default(autoincrement())
  countryId    Int    @map("country_id")
  trendText    String @map("trend_text")
  order        Int    @default(0)
  // { fr: { trendText }, de: { trendText } }
  translations Json?

  // Relations
  country Country @relation(fields: [countryId], references: [id], onDelete: Cascade)

  @@map("country_trends")
}

model News {
  id            Int      @id @default(autoincrement())
  title         String
  titleFr       String?  @map("title_fr")
  body          String?
  description   String?
  descriptionFr String?  @map("description_fr")
  category      String?
  scope         String?
  subcategory   String?
  imageUrl      String?  @map("image_url")
  link          String?
  publishedAt   DateTime @default(now()) @map("published_at")
  isPublished   Boolean  @default(false) @map("is_published")
  translations  Json?
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  @@map("news")
}

model Blog {
  id           Int      @id @default(autoincrement())
  title        String
  slug         String?  @unique
  body         String?
  excerpt      String?
  category     String?
  scope        String?
  subcategory  String?
  author       String?
  imageUrl     String?  @map("image_url")
  publishedAt  DateTime @default(now()) @map("published_at")
  isPublished  Boolean  @default(false) @map("is_published")
  translations Json?
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  @@map("blog")
}

model StudyCountry {
  id                    Int      @id @default(autoincrement())
  name                  String   @unique
  nameFr                String?  @map("name_fr")
  region                String?
  capital               String?
  flag                  String?
  image                 String?
  description           String?
  languageInstruction   String[] @map("language_instruction")
  tuitionRange          String?  @map("tuition_range")
  livingCost            String?  @map("living_cost")
  visaDifficulty        String?  @map("visa_difficulty")
  scholarshipAvailable  Boolean  @default(false) @map("scholarship_available")
  popularScholarships   String[] @map("popular_scholarships")
  popularPrograms       String[] @map("popular_programs")
  admissionRequirements String[] @map("admission_requirements")
  topUniversities       String[] @map("top_universities")
  processingTimeVisa    String?  @map("processing_time_visa")
  studyAvailable        Boolean  @default(true) @map("study_available")
  isValidated           Boolean  @default(false) @map("is_validated")
  // Story 5.5 : provenance (« ai:claude-opus-4-8 » pour un brouillon IA, null si saisie manuelle).
  source                String?
  createdAt             DateTime @default(now()) @map("created_at")
  updatedAt             DateTime @updatedAt @map("updated_at")

  @@map("study_countries")
}

model TourismCountry {
  id                 Int      @id @default(autoincrement())
  name               String   @unique
  nameFr             String?  @map("name_fr")
  region             String?
  capital            String?
  flag               String?
  image              String?
  description        String?
  currency           String?
  language           String?
  bestTime           String?  @map("best_time")
  avgBudgetPerDay    String?  @map("avg_budget_per_day")
  topAttractions     String[] @map("top_attractions")
  visaForAfricans    String?  @map("visa_for_africans")
  processingTimeVisa String?  @map("processing_time_visa")
  directFlightsFrom  String[] @map("direct_flights_from")
  tourismAvailable   Boolean  @default(true) @map("tourism_available")
  isValidated        Boolean  @default(false) @map("is_validated")
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")

  @@map("tourism_countries")
}

/// Fiche visa d'une route « pays d'origine (Afrique) → pays de destination ».
/// Story 4.7 : la fiche ne répond plus seulement « visa requis oui/non » — elle porte
/// tout ce qu'une personne doit savoir et fournir pour l'obtenir : le dossier
/// obligatoire, les conditions personnelles à prouver (ressources, langue, assurance…),
/// la procédure de dépôt et les motifs de refus fréquents.
/// Une route peut porter plusieurs fiches, une par type de visa (étudiant, tourisme…).
model Visa {
  id                 Int      @id @default(autoincrement())
  originCountry      String   @map("origin_country")
  destinationCountry String   @map("destination_country")
  visaType           String   @default("Étudiant") @map("visa_type")
  visaRequired       Boolean  @default(true) @map("visa_required")
  embassyId          Int?     @map("embassy_id")

  // ── Coûts & délais ────────────────────────────────────────────────────────
  processingTime String? @map("processing_time")
  cost           Float?
  currency       String? @default("EUR")
  visaValidity   String? @map("visa_validity") // ex. « 1 an renouvelable »
  entriesType    String? @map("entries_type")  // « Entrée simple » | « Entrées multiples »
  maxStay        String? @map("max_stay")      // ex. « 90 jours par semestre »

  // ── Dossier obligatoire ───────────────────────────────────────────────────
  documentsRequired  Json?   @map("documents_required") // string[]
  passportValidity   String? @map("passport_validity")  // ex. « valide 3 mois après le retour »
  photoSpec          String? @map("photo_spec")         // ex. « 35x45 mm, fond blanc, < 6 mois »
  applicationFormUrl String? @map("application_form_url")

  // ── Conditions personnelles à prouver ─────────────────────────────────────
  fundsAmount             String? @map("funds_amount")     // ex. « 11 904 € sur compte bloqué »
  proofOfFunds            String? @map("proof_of_funds")   // forme acceptée du justificatif
  accommodationProof      String? @map("accommodation_proof")
  insuranceRequired       Boolean @default(false) @map("insurance_required")
  insuranceMinCoverage    String? @map("insurance_min_coverage")
  languageRequirement     String? @map("language_requirement") // ex. « B2 (DELF/TCF) »
  admissionLetterRequired Boolean @default(false) @map("admission_letter_required")
  guarantorRequired       Boolean @default(false) @map("guarantor_required")
  criminalRecordRequired  Boolean @default(false) @map("criminal_record_required")
  medicalExamRequired     Boolean @default(false) @map("medical_exam_required")
  vaccinations            String? @map("vaccinations")
  returnTicketRequired    Boolean @default(false) @map("return_ticket_required")

  // ── Procédure de dépôt ────────────────────────────────────────────────────
  whereToApply       String? @map("where_to_apply") // ambassade, VFS Global, TLScontact…
  appointmentUrl     String? @map("appointment_url")
  biometricsRequired Boolean @default(false) @map("biometrics_required")
  interviewRequired  Boolean @default(false) @map("interview_required")
  applicationSteps   Json?   @map("application_steps") // string[] ordonné

  // ── À savoir ──────────────────────────────────────────────────────────────
  commonRefusalReasons Json?     @map("common_refusal_reasons") // string[]
  notes                String?
  officialSourceUrl    String?   @map("official_source_url")
  lastVerifiedAt       DateTime? @map("last_verified_at")

  // Gate publique (9.2 / FR37) : une fiche non validée reste invisible côté site.
  isValidated Boolean  @default(false) @map("is_validated")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  embassy Embassy? @relation(fields: [embassyId], references: [id], onDelete: SetNull)

  @@unique([originCountry, destinationCountry, visaType])
  @@index([destinationCountry])
  @@map("visas")
}

model Embassy {
  id       Int    @id @default(autoincrement())
  /// Pays REPRÉSENTÉ par la mission (« France » pour l'ambassade de France à Lomé).
  /// C'est ce que contrôle le gate d'une fiche visa : mission.country == destination.
  country  String
  name     String
  location String?
  link     String?
  email    String?
  phone    String?

  // ── Story 4.8 : où se trouve réellement la mission, et qui elle dessert ──────
  /// Pays d'ACCUEIL : « Togo » pour l'ambassade de France à Lomé.
  hostCountry String? @map("host_country")
  city        String?
  address     String?
  /// Lien cartographique (recherche Google Maps à défaut d'une adresse exacte).
  mapsUrl     String? @map("maps_url")
  /// « Ambassade » | « Consulat général » | « Section consulaire » | « Centre de dépôt ».
  type        String? @default("Ambassade")
  /// Pays desservis EN PLUS du pays d'accueil, quand la destination n'a pas de
  /// représentation sur place (l'ambassade de Suède à Abuja couvre le Togo).
  coveredCountries String[] @map("covered_countries")
  /// Gate de publication : une mission non vérifiée n'est pas montrée au public.
  isValidated      Boolean  @default(false) @map("is_validated")

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  visas Visa[]

  @@index([country])
  @@index([hostCountry])
  @@map("embassies")
}

model Accommodation {
  id            Int      @id @default(autoincrement())
  name          String
  country       String
  city          String
  type          String // "studio"|"shared"|"residence"|"homestay"
  pricePerMonth Float    @map("price_per_month")
  currency      String   @default("EUR")
  contact       String?
  description   String?
  images        Json?
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  @@map("accommodations")
}

// Story 5.4 : centres de langue (potentiels partenaires), cibles de redirection quand
// l'étudiant n'atteint pas l'exigence de langue d'une université (5.3 → UI 5.8).
model LanguageCenter {
  id       Int     @id @default(autoincrement())
  name     String
  // `country` reprend le vocabulaire **anglais** de University.country (« Germany »,
  // « France »…) : la redirection depuis une université passe ?country=<University.country>,
  // les deux catalogues doivent donc parler la même langue.
  country  String
  city     String?
  language String // vocabulaire FR, cohérent avec UserLanguage/requiredLanguage (ex. « Anglais »)
  levels   String? // résumé d'affichage des niveaux, ex. « A1-C1 » (dérivé de levelsOffered)
  link     String?

  // Fiche détaillée (story 5.14) : ce qu'un étudiant doit savoir avant de s'inscrire.
  description        String?
  address            String?
  email              String?
  phone              String?
  registrationUrl    String?  @map("registration_url")
  image              String?
  levelsOffered      String[] @map("levels_offered") // CEFR A1..C2 (ou HSK 1..6 pour le chinois)
  courseTypes        String[] @map("course_types") // « Intensif », « En ligne », « Cours du soir »…
  examsPrepared      String[] @map("exams_prepared") // « TestDaF », « IELTS », « DELF »…
  accreditations     String[] // « Eaquals », « IALC », « Bildungsurlaub »…
  universityPartners String[] @map("university_partners") // universités partenaires (noms libres)
  // Tarif **indicatif** : un centre publie rarement un prix unique, d'où l'unité explicite.
  priceFrom          Float?   @map("price_from")
  priceUnit          String?  @map("price_unit") // « semaine » | « mois » | « cours » | « heure »
  currency           String   @default("EUR")
  weeklyHours        Int?     @map("weekly_hours")
  classSize          Int?     @map("class_size")
  startDates         String?  @map("start_dates") // « Rentrées chaque lundi », « Sessions mensuelles »…

  offersVisaSupport   Boolean @default(false) @map("offers_visa_support") // lettre d'inscription pour le visa
  offersAccommodation Boolean @default(false) @map("offers_accommodation")
  offersPathway       Boolean @default(false) @map("offers_pathway") // Studienkolleg / année préparatoire universitaire

  isPartner   Boolean  @default(false) @map("is_partner")
  // Gate de publication (cohérent avec Epic 9) : la liste publique ne sert que le validé.
  isValidated Boolean  @default(false) @map("is_validated")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@index([language])
  @@index([country])
  @@index([isValidated])
  @@map("language_centers")
}

// Epic 6 — Tourisme ciblé.
// Story 6.1 : programmes tourisme à destination fixe (safari/sport) + itinéraire/transport.
model TourismProgram {
  id          Int      @id @default(autoincrement())
  title       String
  subcategory String // « safari » | « sport » | ...
  country     String // destination fixe
  city        String?
  description String?
  itinerary   String?
  transport   String?
  price       Float?
  currency    String   @default("EUR")
  images      Json?
  isValidated Boolean  @default(false) @map("is_validated")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@index([subcategory])
  @@map("tourism_programs")
}

// Story 6.2 : événements tourisme (publiés / à venir).
model TourismEvent {
  id          Int       @id @default(autoincrement())
  title       String
  description String?
  // `country` reprend le nom anglais de TourismCountry.name : c'est ce qui rattache
  // l'événement au plan annuel du pays (quota d'événements par pays et par an).
  country     String?
  city        String?
  location    String?
  startDate   DateTime? @map("start_date")
  status      String    @default("upcoming") // « proposed » | « upcoming » | « past »
  link        String?
  imageUrl    String?   @map("image_url")
  isPublished Boolean   @default(false) @map("is_published")

  // Story 6.8 : programmation annuelle par pays et aide à la décision.
  subcategory    String? // « Safari », « Sport », « Festival », « Culture »…
  // Année de programmation : un événement peut être proposé avant que sa date exacte
  // soit connue, `year` porte donc le plan et `startDate` reste nullable.
  year           Int?
  endDate        DateTime? @map("end_date")
  // Faux tant que la date n'est pas confirmée par une source officielle : l'admin voit
  // d'un coup d'œil ce qui reste à vérifier avant publication.
  datesConfirmed Boolean   @default(false) @map("dates_confirmed")
  priceFrom      Float?    @map("price_from")
  currency       String    @default("EUR")
  capacity       Int?
  audience       String? // « Familles », « Jeunes actifs », « Groupes »…
  offerIncludes  String[]  @map("offer_includes") // « Vol », « Hébergement », « Transferts », « Billetterie »
  highlights     String[]
  internalNotes  String?   @map("internal_notes") // aide à la décision, jamais servie au public

  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@index([country])
  @@index([year])
  @@map("tourism_events")
}

/// Story 6.8 : réglages éditoriaux modifiables depuis l'admin (clé/valeur en texte).
/// Premier usage : le nombre d'événements attendus par pays de tourisme et par an.
model AppSetting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("app_settings")
}

// Story 6.3 : partenaires (redirection trackée pour le tourisme global).
model Partner {
  id          Int      @id @default(autoincrement())
  name        String
  category    String?
  url         String
  logoUrl     String?  @map("logo_url")
  description String?
  clickCount  Int      @default(0) @map("click_count")
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@index([category])
  @@map("partners")
}

// Epic 7 — Espace voyage & gestion des trips.
model Trip {
  id             Int       @id @default(autoincrement())
  userId         Int       @map("user_id")
  title          String
  status         String    @default("planning") // « planning » | « upcoming » | « completed »
  startDate      DateTime? @map("start_date")
  endDate        DateTime? @map("end_date")
  lastReminderAt DateTime? @map("last_reminder_at") // idempotence des emails de rappel (7.5)
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  user           User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  destinations   TripDestination[]
  services       TripService[]
  checklistItems TripChecklistItem[]

  @@index([userId])
  @@map("trips")
}

model TripDestination {
  id            Int       @id @default(autoincrement())
  tripId        Int       @map("trip_id")
  country       String
  city          String?
  arrivalDate   DateTime? @map("arrival_date")
  departureDate DateTime? @map("departure_date")
  order         Int       @default(0)
  createdAt     DateTime  @default(now()) @map("created_at")

  trip     Trip          @relation(fields: [tripId], references: [id], onDelete: Cascade)
  services TripService[]

  @@index([tripId])
  @@map("trip_destinations")
}

model TripService {
  id            Int      @id @default(autoincrement())
  tripId        Int      @map("trip_id")
  destinationId Int?     @map("destination_id")
  type          String // « flight » | « accommodation » | « visa » | « insurance » | « bank » | « language » ...
  label         String
  status        String   @default("pending") // « pending » | « done »
  data          Json?
  createdAt     DateTime @default(now()) @map("created_at")

  trip        Trip             @relation(fields: [tripId], references: [id], onDelete: Cascade)
  destination TripDestination? @relation(fields: [destinationId], references: [id], onDelete: SetNull)

  @@index([tripId])
  @@map("trip_services")
}

model TripChecklistItem {
  id        Int      @id @default(autoincrement())
  tripId    Int      @map("trip_id")
  label     String
  category  String?
  isDone    Boolean  @default(false) @map("is_done")
  order     Int      @default(0)
  createdAt DateTime @default(now()) @map("created_at")

  trip Trip @relation(fields: [tripId], references: [id], onDelete: Cascade)

  @@index([tripId])
  @@map("trip_checklist_items")
}

// Epic 8 — Contact intelligent & Newsletter.
// Story 8.1 : message de contact rattaché à l'arbre catégorie/sous-catégorie (8.2).
// userId + isPremium capturés au moment de l'envoi pour l'insight client vs premium (8.3).
model ContactMessage {
  id          Int      @id @default(autoincrement())
  name        String
  email       String
  subject     String?
  category    String? // id de Category (arbre des sujets 8.2)
  subcategory String?
  message     String
  userId      Int?     @map("user_id") // null => visiteur non connecté
  isPremium   Boolean  @default(false) @map("is_premium") // snapshot à l'envoi
  status      String   @default("new") // « new » | « read » | « archived »
  createdAt   DateTime @default(now()) @map("created_at")

  @@index([category])
  @@index([status])
  @@map("contact_messages")
}

// Story 8.4 : abonnés newsletter sans compte (les utilisateurs ont newsletterStudy/Tourism sur User).
model NewsletterSubscriber {
  id        Int      @id @default(autoincrement())
  email     String   @unique
  study     Boolean  @default(false)
  tourism   Boolean  @default(false)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("newsletter_subscribers")
}

// Epic 10 — Orientation (v1.1).
// Story 10.1 (FR34/FR35) : ressources d'orientation études & formations.
// `location` (lieu de la formation) n'est exposé qu'aux premium (FR35).
model OrientationResource {
  id          Int      @id @default(autoincrement())
  title       String
  type        String // « guide » | « book » | « company » | « certification »
  category    String? // domaine (ex. « informatique »)
  description String?
  provider    String? // organisme / éditeur
  link        String?
  location    String? // lieu de la formation — PREMIUM ONLY
  imageUrl    String?  @map("image_url")
  isValidated Boolean  @default(true) @map("is_validated")
  order       Int      @default(0)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@index([type])
  @@index([category])
  @@map("orientation_resources")
}

model Notification {
  id        Int      @id @default(autoincrement())
  userId    Int      @map("user_id")
  type      String // "visa_alert"|"newsletter"|"trip_reminder"
  title     String
  message   String
  isRead    Boolean  @default(false) @map("is_read")
  data      Json?
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("notifications")
}

enum BookingStatus {
  PENDING   @map("pending")
  CONFIRMED @map("confirmed")
  CANCELLED @map("cancelled")
  COMPLETED @map("completed")

  @@map("BookingStatus")
}

model UserBooking {
  id          Int           @id @default(autoincrement())
  userId      Int           @map("user_id")
  serviceId   Int           @map("service_id")
  status      BookingStatus @default(PENDING)
  bookingData Json?         @map("booking_data")
  createdAt   DateTime      @default(now()) @map("created_at")
  updatedAt   DateTime      @updatedAt @map("updated_at")

  // Relations
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  service Service @relation(fields: [serviceId], references: [id])

  @@map("user_bookings")
}

model University {
  id                    Int      @id @default(autoincrement())
  name                  String   @unique
  city                  String
  website               String?
  applicationUrl        String?  @map("application_url")
  specialty             String?
  country               String   @default("Germany")
  // Story 5.3 : exigence de langue (nom de langue + niveau CEFR A1..C2), nullable.
  requiredLanguage      String?  @map("required_language")
  requiredLanguageLevel String?  @map("required_language_level")
  // Story 5.13 : profil d'admission. Les systèmes de notation diffèrent d'un pays à
  // l'autre (mention au bac, GPA /4.0, A-levels, Numerus Clausus, Gaokao…) : on
  // stocke donc la note plancher telle qu'elle se publie, en texte, plutôt qu'un
  // nombre qui n'aurait pas la même signification d'un pays à l'autre.
  minimumGrade          String?  @map("minimum_grade")
  // Sélectivité et conditions de dossier en clair (concours, entretien, portfolio…).
  admissionRequirements String?  @map("admission_requirements")
  createdAt             DateTime @default(now()) @map("created_at")

  // Relations
  programs UniversityProgram[]

  @@map("universities")
}

model UniversityProgram {
  id           Int      @id @default(autoincrement())
  universityId Int      @map("university_id")
  name         String
  level        String // "Bachelor" or "Master"
  createdAt    DateTime @default(now()) @map("created_at")

  // Relations
  university University @relation(fields: [universityId], references: [id], onDelete: Cascade)

  @@unique([universityId, name, level], map: "uq_university_program_universityId_name_level")
  @@map("university_programs")
}

// ─── Catalogue « annuaire » — remplace les listes en dur du front ─────────────
// Ces tables alimentent les pages vols, assurances, banques, sites, restaurants,
// hébergements tourisme, jobs, formations et démarches administratives, qui
// affichaient jusqu'ici des constantes `mock*` côté React.
// Contrat commun : `isActive` masque une entrée sans la supprimer (l'admin ne perd
// rien), et les listes multi-valeurs sont des Json (tableaux de chaînes) pour rester
// éditables depuis le CRUD générique de l'admin.

model Flight {
  id          Int      @id @default(autoincrement())
  airline     String
  fromCountry String   @map("from_country")
  fromCity    String   @map("from_city")
  toCountry   String   @map("to_country")
  toCity      String   @map("to_city")
  departure   String
  arrival     String
  price       String
  // "Economy" | "Business" | "Economy Premium" pour le grand public,
  // "Student Basic" | "Student Flex" | "Student Special" pour l'espace étudiant.
  type        String
  audience    String   @default("general") // "general" | "student"
  duration    String?
  stops       Int      @default(0)
  baggage     String?
  features    Json?
  image       String?
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@index([audience])
  @@index([fromCountry])
  @@index([toCountry])
  @@map("flights")
}

model InsurancePlan {
  id             Int      @id @default(autoincrement())
  provider       String
  country        String
  // "general" (page Assurances) | "student" (espace études) | "travel" (espace tourisme)
  audience       String   @default("general")
  coverageTypes  Json?    @map("coverage_types")
  benefits       Json?
  insuranceTypes Json?    @map("insurance_types")
  monthlyPremium String?  @map("monthly_premium")
  coverage       String?
  rating         Float?
  reviews        Int?
  image          String?
  description    String?
  isActive       Boolean  @default(true) @map("is_active")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  @@index([audience])
  @@index([country])
  @@map("insurance_plans")
}

model Bank {
  id          Int      @id @default(autoincrement())
  name        String
  country     String
  image       String?
  description String?
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  accountTypes BankAccountType[]

  @@index([country])
  @@map("banks")
}

// Un compte proposé par une banque. Table séparée car une banque en propose
// plusieurs et la page les affiche en onglets.
model BankAccountType {
  id              Int      @id @default(autoincrement())
  bankId          Int      @map("bank_id")
  name            String
  features        Json?
  monthlyFee      String?  @map("monthly_fee")
  requirements    Json?
  minimumDeposit  String?  @map("minimum_deposit")
  cardType        String?  @map("card_type")
  withdrawalLimit String?  @map("withdrawal_limit")
  onlineBanking   Boolean  @default(true) @map("online_banking")
  studentPerks    Json?    @map("student_perks")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  bank Bank @relation(fields: [bankId], references: [id], onDelete: Cascade)

  @@index([bankId])
  @@map("bank_account_types")
}

model TouristSite {
  id          Int      @id @default(autoincrement())
  name        String
  country     String
  city        String?
  // Libellé affiché tel quel (« Paris, France ») ; `country`/`city` servent aux filtres.
  location    String
  category    String // "Landmarks" | "Historical" | "Religious Sites" | "Museums" | "Parks" | "Entertainment"
  description String?
  rating      Float?
  reviews     Int?
  price       String?
  features    Json?
  image       String?
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@index([country])
  @@index([category])
  @@map("tourist_sites")
}

model Restaurant {
  id         Int      @id @default(autoincrement())
  name       String
  country    String
  city       String?
  location   String
  cuisine    String
  priceRange String   @map("price_range") // "€" | "€€" | "€€€" | "€€€€"
  rating     Float?
  reviews    Int?
  features   Json?
  image      String?
  isActive   Boolean  @default(true) @map("is_active")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@index([country])
  @@index([cuisine])
  @@map("restaurants")
}

// Distinct de `Accommodation` (story 5.6), qui est le logement étudiant au mois :
// ici c'est l'hébergement touristique, tarifé à la nuit et noté par les voyageurs.
model TourismAccommodation {
  id          Int      @id @default(autoincrement())
  name        String
  country     String
  city        String
  type        String // "Hotel" | "Resort" | "Apartment" | "Guesthouse" | "Hostel"
  priceRange  String   @map("price_range")
  amenities   Json?
  rating      Float?
  reviews     Int?
  description String?
  image       String?
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  @@index([country])
  @@index([city])
  @@map("tourism_accommodations")
}

model Job {
  id           Int       @id @default(autoincrement())
  title        String
  company      String
  country      String
  city         String?
  location     String
  type         String // "Full-time" | "Part-time" | "Contract" | "Internship" | "Remote"
  salary       String?
  experience   String?
  description  String?
  requirements Json?
  benefits     Json?
  applyUrl     String?   @map("apply_url")
  image        String?
  // Date de publication : le front l'affiche en « il y a X jours » (date-fns).
  postedAt     DateTime? @map("posted_at")
  isActive     Boolean   @default(true) @map("is_active")
  createdAt    DateTime  @default(now()) @map("created_at")
  updatedAt    DateTime  @updatedAt @map("updated_at")

  @@index([country])
  @@index([type])
  @@map("jobs")
}

model Training {
  id            Int      @id @default(autoincrement())
  provider      String
  country       String
  city          String?
  course        String
  duration      String?
  price         String?
  certification String?
  category      String? // "Technology" | "Healthcare" | "Business" | ...
  rating        Float?
  reviews       Int?
  features      Json?
  image         String?
  description   String?
  link          String?
  isActive      Boolean  @default(true) @map("is_active")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  @@index([country])
  @@index([category])
  @@map("trainings")
}

// Prestataire de démarches administratives. Les trois pages (visa travail,
// légalisation de documents, reconnaissance de diplôme) partagent la même fiche :
// un prestataire, un pays, un délai, un prix, des pièces à fournir. `serviceType`
// dit laquelle des trois l'affiche, et les champs spécifiques restent nullables.
model ServiceProvider {
  id              Int      @id @default(autoincrement())
  provider        String
  country         String
  serviceType     String   @map("service_type") // "work_visa" | "legalization" | "recognition"
  services        Json?
  visaTypes       Json?    @map("visa_types") // serviceType = "work_visa"
  acceptedDegrees Json?    @map("accepted_degrees") // serviceType = "recognition"
  documentTypes   Json?    @map("document_types") // serviceType = "legalization"
  processingTime  String?  @map("processing_time")
  price           String?
  requirements    Json?
  features        Json?
  successRate     String?  @map("success_rate")
  rating          Float?
  link            String?
  isActive        Boolean  @default(true) @map("is_active")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  @@index([serviceType])
  @@index([country])
  @@map("service_providers")
}
